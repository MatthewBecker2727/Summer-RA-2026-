```{r, include=FALSE}


dfcalls_all <- dfcalls_all %>%
  filter(total_calls > 0) %>%
filter(days_until_spring_dst %in% -21:21) %>%
  mutate(
    year = year, #reduntant but keeps the variables for me
    month = month,
    day_of_week = lubridate::wday(date, label = FALSE),
    DST = ifelse(days_until_spring_dst >= 0, 1, 0),
    DST_x_days = DST * days_until_spring_dst)
  
```

```{r}
# Beta * DST = DST
# Alpha(1) * days = days_until_spring_dst
# Alpha(2) * days = DST_x_days 
# Alpha(i) = as.factor(city)
#DOW = as.factor(day_of_week)
#Month = as.factor(month)
#Year = as.factor(year)

regression_calls <- lm(
  total_calls ~ DST + days_until_spring_dst + DST_x_days + as.factor(city) + as.factor(day_of_week) + as.factor(month) + as.factor(year), 
  dfcalls_all
)

summary(regression_calls)
```

