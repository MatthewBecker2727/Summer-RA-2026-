```{r, include = FALSE}
library(lubridate)

calls <- calls %>% 
  rename(
    response_datetime = call.sign.dispatch.time,
    arrived_datetime  = cad.event.arrived.time,
    service_seconds   = call.sign.total.service.time..s.
  )


calls <- calls %>%
  mutate(
   response_dt_parsed = parse_date_time(response_datetime, orders = c("mdY HMS p", "mdY HMS", "mdY HM p", "mdY HM", "Ybd HMS p", "Ybd HMS")),
    arrived_dt_parsed  = parse_date_time(arrived_datetime,  orders = c("mdY HMS p", "mdY HMS", "mdY HM p", "mdY HM", "Ybd HMS p", "Ybd HMS")),
    service_seconds_clean = parse_number(service_seconds),
    closed_dt_parsed   = response_dt_parsed + seconds(service_seconds_clean),
   
    # Extract clean Dates (YYYY-MM-DD)
    response_date = as.Date(response_dt_parsed),
    arrived_date  = as.Date(arrived_dt_parsed),
    closed_date   = as.Date(closed_dt_parsed),
    
    # Extract clean 24-hour Times (HH:MM:SS)
    response_time = format(response_dt_parsed, "%H:%M:%S"),
    arrived_time  = format(arrived_dt_parsed,  "%H:%M:%S"),
    closed_time   = format(closed_dt_parsed,   "%H:%M:%S")
  ) 

