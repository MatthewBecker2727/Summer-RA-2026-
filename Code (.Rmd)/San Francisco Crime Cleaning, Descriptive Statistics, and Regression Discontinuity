```{r, include=FALSE}
zip_path <- "Data/raw/San_Francisco/Crimes.zip"
temp_dir <- tempdir()

extracted_files <- unzip(zip_path, exdir = temp_dir)

csv_files <- extracted_files[grepl("\\.csv$", extracted_files)]

calls <- rbindlist(lapply(csv_files, fread), fill = TRUE)
