#Hartford 

vfiles <- list.files("../Data/raw/Hartford/crimes", pattern = "\\.csv$", full.names = TRUE)

getwd()
# Empty list 

dfcalls_list <- vector("list", length(vfiles)) 

# Reads each file and appends it to a list 

for(X in seq_along(vfiles)){

  dftemp <- fread(vfiles[X], check.names = TRUE) %>% 
   rename_all(tolower) %>% 
    mutate_all(as.character) %>% 
    select(-starts_with("v")) 

 if("date1" %in% names(dftemp)){
  dftemp <- dftemp %>% 
    rename(date = date1)
}

if(grepl("Weekly", vfiles[X])){ 
  dftemp <- dftemp %>% 
    rename(dateend = date) 
}
  dfcalls_list[[X]] <- dftemp 
} 


rm(dftemp, X, vfiles); gc() 

#Bind all the elements of the list into a single data frame. 

dfcalls_hartford <- bind_rows(
  lapply(dfcalls_list, function(x) {
    if ("date1" %in% names(x)) {
      x <- x %>% rename(date = date1)
    }
    x
  })
) %>%
  select(c("date", "time_24hr", "time", "description_1", "description_2",
           "description1", "description", "priority", "call_initiated_by")) %>%
mutate(
  time = coalesce(
  as.character(time_24hr),
  as.character(time)
) %>%
  str_pad(width = 4, side = "left", pad = "0") %>%
  sub("^(\\d{2})(\\d{2})$", "\\1:\\2:00", .),

datetime = lubridate::ymd_hms(
  paste(as.Date(date), time)
),
    
    date = as.Date(datetime),
    year = year(datetime),
     month    = lubridate::month(datetime),  
    day  = lubridate::day(datetime),
    day_of_week = lubridate::wday(datetime, week_start = 1),
    hour = hour(datetime), 
    minute = minute(datetime),
      
   #no disposition
   priority = case_when(
      priority == "A" ~ "Priority 1",
      priority == "B" ~ "Priority 2",
      priority == "C" ~ "Priority 3",
      TRUE ~ NA_character_
    ),
    priority_number = as.numeric(str_extract(priority, "\\d+")),
    
    description_final = coalesce(description_1, description_2, description1, description),
description_clean = str_trim(str_remove(description_final, "\\s*-\\s*(ACTIVE|INACTIVE)$")),

calls_disorder = as.integer(description_clean %in% c("BREACH OF PEACE", "NOISE COMPLAINT", "PROPERTY DAMAGE", "VICE OFFENSE (SPECIFY)", "THREATENING/HARASSMENT", "INTOXICATED PERSON", "GROUP DISTURBING")),
calls_behavior = as.integer(description_clean %in% c("SUSPICIOUS PERSON", "SUSPICIOUS VEHICLE", "LOITERING", "TRESPASSING")),
calls_traffic = as.integer(description_clean %in% c("ACCIDENT (MOTOR VEHICLE)", "ACCIDENT (M/V W/ INJURY)", "ACCIDENT M/V", "ACCIDENT M/V W/ INJURY")),
calls_gun = as.integer(description_clean %in% c("SHOTS FIRED", "GUN INVOLVED")),
calls_robbery = as.integer(description_clean %in% c("MUGGING/STREET ROBBERY", "PURSE SNATCH")),
calls_burglary = as.integer(description_clean %in% c("BREAKING AND ENTERING", "BURGLARY")),

calls_aggravated_assault = as.integer(description_clean %in% c("ASSAULT--SERIOUS", "ASSAULT - SERIOUS", "ASSAULT - SERIOUS W/ GUN", "ASSAULT  - W/ OTHER WEAPON")),
calls_theft = as.integer(description_clean == "LARCENY"),
calls_mv_theft = as.integer(description_clean == "STOLEN VEHICLE"),
    
    calls_violent = calls_robbery + calls_aggravated_assault,
    calls_property = calls_burglary + calls_theft + calls_mv_theft,
    calls_index = calls_violent + calls_property,
    
              initiator = case_when(
      call_initiated_by == "OFFICER" ~ "Officer",
      call_initiated_by %in% c("CITIZEN", "E911 CALL") ~ "Citizen",
      call_initiated_by == "" ~ "Not Available",
      TRUE ~ NA_character_)
  
    ) %>% 
  filter(year %in% 2012:2024) %>%
   select(-c(time_24hr, priority, call_initiated_by, description_1, description_2, description1, description, description_final, description_clean))
 
  

