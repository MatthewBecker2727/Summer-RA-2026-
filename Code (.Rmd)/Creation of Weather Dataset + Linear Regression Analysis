#Data processing at the day-year-city level
#temperature (Celsius), precipitation (daily mm), humidity (percentages), visibility (meters)
dfweather <- bind_rows(weatherlist) %>%
  mutate(date = as.Date(date),
         year = year(date),
         month = month(date),
         day = day(date)) %>%
  rename(temperature = air_temp,
         precipitation = precip_6 ,
         humidity = RH,
         visibility = visibility) %>%
  select(city, date, year, month, day, temperature, precipitation, humidity, visibility) %>%
  group_by(city, date, year, month, day) %>%
  mutate_at(vars(temperature:visibility), as.numeric) %>%
  #mutate(temperature = (temperature - 32)/1.8) %>%
  summarise(temperature = mean(temperature, na.rm = TRUE), 
            precipitation = sum(precipitation, na.rm = TRUE),
            humidity = mean(humidity, na.rm = TRUE),
            visibility = mean(visibility, na.rm = TRUE)) %>%
  mutate_at(vars(temperature:visibility), function(x) round(x, digits = 2))



