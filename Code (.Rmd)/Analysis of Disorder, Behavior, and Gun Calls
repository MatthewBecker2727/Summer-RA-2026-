```{r}
#create variables

    disorder_desc = c("Disturbance Other", "Family Disturbance", "Disturbance Hs", "Disturbance Urgent",
      "Disturbance Service", "Disturbance/Othr", "Disturbance Vehicle Urgent",
      "Mischief / Vandalism", "Criminal Mischief", "Crim Mischief",
      "Drugs", "Poss Marijuana", "Poss Controlled Sub/Narcotic", "Poss Drg Paraphernalia",
      "Prostitution")

    behavior_desc = c("Suspicious Person", "Suspicious Vehicle", "Suspicious Unknown", "Prowler Hs",
      "Trespass Urgent", "Criminal Trespass", "Criminal Trespass Notice", "Crim Trespass")

    gun_desc = c("Shots Fired", "Gun Hs", "Gun Urgent", "Gun Other", "Shoot/Stab Hs",
      "Ucw")
  
dfcalls_austin <- dfcalls_austin %>%
  mutate(
    disorder_flag = as.integer(final.problem.description %in% disorder_desc),
    behavior_flag = as.integer(final.problem.description %in% behavior_desc),
    gun_flag      = as.integer(final.problem.description %in% gun_desc)
  )

#map category 
category_map <-bind_rows(
  tibble(final.problem.description = disorder_desc, category = "Disorder"),
  tibble(final.problem.description = behavior_desc, category = "Behavior"),
  tibble(final.problem.description = gun_desc, category = "Gun")
)


composition_austin <- dfcalls_austin %>%
  filter(final.problem.description %in% category_map$final.problem.description) %>%
  inner_join(category_map, by = "final.problem.description") %>%
  count(category, final.problem.description, name = "n") %>%
  group_by(category) %>%
  mutate(share = n / sum(n)) %>%
  ungroup() %>%
  # order categories, and order descriptions within each stack by share (desc)
  mutate(
    category = factor(category, levels = c("Disorder", "Behavior", "Gun")),
    final.problem.description = str_to_title(final.problem.description)
  ) %>%
  arrange(category, desc(share)) %>%
  mutate(final.problem.description = factor(final.problem.description, levels = unique(final.problem.description)))
```

```{r, fig.width = 10 }
p <- ggplot(composition_austin, aes(x = category, y = share, fill = final.problem.description)) +
  geom_col(width = 1, color = "white", linewidth = 0.5) +
  geom_text(
    aes(label = ifelse(share >= 0.04,
                        paste0(final.problem.description, "\n", percent(share, accuracy = 1)),
                        "")),
    position = position_stack(vjust = 0.5),
    size = 2.8, color = "black", lineheight = 0.85
  ) +
  facet_wrap(~ category, scales = "free_x") +
  scale_y_continuous(labels = percent_format(), expand = c(0, 0)) +
  labs(
    title = "Austin Composition of Disorder, Behavior, and Gun Calls",
    subtitle =  "2012–2024",
    x = NULL,
    y = "% of category"
  ) +
  theme_minimal(base_size = 12) +
  theme(
    legend.position = "none",
    panel.grid.major.x = element_blank(),
    panel.grid.minor = element_blank(),
    plot.title = element_text(face = "bold"),
    strip.text = element_text(face = "bold", size = 12),
    axis.text.x = element_blank()
  )

print(p)


