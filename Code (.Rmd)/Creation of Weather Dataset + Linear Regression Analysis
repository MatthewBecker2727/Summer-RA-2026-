```{r, include=FALSE}
#steps above but filter for sunset/sunrise
dfweather <- bind_rows(weatherlist) %>%
  mutate(hour  = hour(date),      
         date  = as.Date(date),
         year  = year(date),
         month = month(date),
         day   = day(date)) %>%
 filter(complete.cases(date)) %>%
  mutate(sunrise = ifelse(hour %in% 6:7, 1, 0),
         sunset = ifelse(hour %in% 18:19, 1, 0)) %>%
  rename(temperature = air_temp,
         precipitation = precip_6 ,
         humidity = RH,
         visibility = visibility) %>%
  select(city, date, year, month, day, hour, sunrise, sunset, temperature, precipitation, humidity, visibility) %>%
  mutate_at(vars(temperature:visibility), as.numeric)


dfsunrise <- dfweather %>%
  filter(sunrise == 1) %>%
  group_by(city, year, month, day) %>%
  summarise(temperature_sunrise = mean(temperature, na.rm = TRUE), 
            precipitation_sunrise = sum(precipitation, na.rm = TRUE),
            humidity_sunrise = mean(humidity, na.rm = TRUE),
            visibility_sunrise = mean(visibility, na.rm = TRUE)) %>%
  mutate_at(vars(temperature_sunrise:visibility_sunrise), function(x) round(x, digits = 2)) %>%
  as.data.frame()

#sunset
dfsunset <- dfweather %>%
  filter(sunset == 1) %>%
  group_by(city, year, month, day) %>%
  summarise(temperature_sunset = mean(temperature, na.rm = TRUE), 
            precipitation_sunset = sum(precipitation, na.rm = TRUE),
            humidity_sunset = mean(humidity, na.rm = TRUE),
            visibility_sunset = mean(visibility, na.rm = TRUE)) %>%
  mutate_at(vars(temperature_sunset:visibility_sunset), function(x) round(x, digits = 2)) %>%
  as.data.frame()


#Merge all data
dfweather <- dfsunrise %>%
  left_join(dfsunset, by = c("city", "year", "month", "day"))

#export data
fwrite(dfweather, "Data/processed/hour-year-city_data_2012-2024.csv")
dfweather <- fread("Data/processed/hour-year-city_data_2012-2024.csv")

rm(dfweather, dfsunrise, dfsunset, weatherlist)

