```{r, include = FALSE}
library(lubridate)

calls <- calls %>% 
  rename(
    response_datetime = received_datetime,
    arrived_datetime  = onscene_datetime,
    closed_datetime   = close_datetime
  )


calls <- calls %>%
  mutate(
response_dt_parsed = parse_date_time(
    response_datetime, orders = c("mdY IMS p", "Ymd IMS p", "Ymd HMS", "mdY IM p", "mdy HMS p")),
arrived_dt_parsed = parse_date_time(
    arrived_datetime, orders = c("Ymd IMS p", "Ymd IMS p", "Ymd HMS", "mdY IM p", "mdy HMS p")),
closed_dt_parsed = parse_date_time(
    closed_datetime, orders = c("Ymd IMS p", "Ymd IMS p", "Ymd HMS", "mdY IM p", "mdy HMS p")),



    # Extract clean Dates (YYYY-MM-DD)
    response_date = as.Date(response_dt_parsed),
    arrived_date  = as.Date(arrived_dt_parsed),
    closed_date   = as.Date(closed_dt_parsed),
    
    # Extract clean 24-hour Times (HH:MM:SS)
    response_time = format(response_dt_parsed, "%H:%M:%S"),
    arrived_time  = format(arrived_dt_parsed,  "%H:%M:%S"),
    closed_time   = format(closed_dt_parsed,   "%H:%M:%S")
  ) 

```


```{r}
calls_sorted <- calls %>%
  mutate( 
    disposition = case_when(
       `disposition` %in% c("HAN", "GOA", "CIT", "ADV", "REP", "UTL", "NOM", "ND", "PAS", "CAN", "NCR", "ARR", "ABA") ~ `disposition`,
      TRUE ~ NA_character_),
    disposition_clean = str_trim(toupper(disposition)),
      calls_disposition_handled = as.integer(disposition_clean == "HAN"),
      calls_disposition_gone_on_arrival = as.integer(disposition_clean ==  "GOA"),
      calls_disposition_cited = as.integer(disposition_clean == "CIT"),
      calls_disposition_advised = as.integer(disposition_clean == "ADV"),
      calls_disposition_report = as.integer(disposition_clean == "REP"),
      calls_disposition_unable_to_locate = as.integer(disposition_clean ==  "UTL"),
      calls_disposition_no_merit = as.integer(disposition_clean ==  "NOM"),
      calls_disposition_no_disposition = as.integer(disposition_clean ==  "ND"),
      calls_disposition_premise_secure = as.integer(disposition_clean ==  "PAS"),
      calls_disposition_cancel = as.integer(disposition_clean ==  "CAN"),
      calls_disposition_noncriminal = as.integer(disposition_clean ==  "NCR"),
       calls_disposition_arrest = as.integer(disposition_clean ==  "ARR"),
       calls_disposition_abated = as.integer(disposition_clean ==  "ABA"),
  
     priority = `priority_original`,
    priority = case_when(
      priority == "A" ~ "Priority 1",
      priority == "B" ~ "Priority 2",
      priority == "C" ~ "Priority 3",
      TRUE ~ NA_character_
    ),
    type_clean = str_trim(toupper(call_type_original_desc)),
   
    calls_disorder = as.integer(type_clean %in% c("VANDALISM DV", "PERSON DUMPING", "PROSTITUTE/SOLICITE", "JUVENILE DISTURBANCE", "GRAFFITI VANDALISM", "PERSON SCREAMING", "INDECENT EXPOSURE", "VANDALISM", "NOISE NUISANCE", "HOMELESS COMPLAINT")),
    calls_behavior = as.integer(type_clean %in% c("STALKING", "AGGR SOLICITING", "PROWLER", "PERSON W/GUN", "PERSON W/KNIFE", "THREATS / HARASSMENT", "SUSPICIOUS VEHICLE", "TRESPASSER", "SUSPICIOUS PERSON")),
    calls_traffic = as.integer(type_clean  %in% c("MVA+INJURIES", "AUTO VS PED", "INJURY VEH ACCIDENT", "VEH ACCIDENT")),
    calls_gun = as.integer(type_clean %in% c("SHOOTING", "SHOT SPOTTER", "SHOTS FIRED")),
        calls_robbery = as.integer(type_clean  %in% c("PURSE SNATCH", "ROBBERY", "STRONGARM ROBBERY")),
        calls_aggravated_assault = as.integer(type_clean  %in% c("FIGHT W/WEAPONS", "AGG ASSAULT / ADW", "ASSAULT / BATTERY DV")),
        calls_burglary = as.integer(type_clean  %in% c("PERSON BREAKING IN", "BURGLARY")),
        calls_theft = as.integer(type_clean  %in% c("STOLEN PROPERTY", "GRAND THEFT", "PETTY THEFT")),
        calls_mv_theft = as.integer(type_clean  == "STOLEN VEHICLE"),

            calls_violent = calls_robbery + calls_aggravated_assault,
            calls_property = calls_burglary + calls_theft + calls_mv_theft,
            calls_index = calls_violent + calls_property,
    
              initiator = case_when(
                `onview_flag` == "Y" ~ "Officer",
                `onview_flag` == "N" ~ "Citizen",
                TRUE ~ NA_character_
              ), 
    
    datetime = lubridate::parse_date_time(
  response_datetime, 
  orders = c("Ymd IMS p", "mdy IMS p", "mdy IM p", "ymd HMS", "mdy IM")
),
    date = as.Date(datetime),
    year = year(datetime),
    month = lubridate::floor_date(datetime, "month"),
    day_of_week = lubridate::wday(datetime, week_start = 1),
    hour = hour(datetime), 
    minute = minute(datetime)
    ) %>% 
    filter(!is.na(minute), !is.na(initiator), !is.na(hour), !is.na(day_of_week), !is.na(date), !is.na(month), !is.na(priority))
```


