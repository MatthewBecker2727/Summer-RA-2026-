weatherlist <- list()
counter <- 1

for(X in 1:length(vstations)){
  for(Z in 2012:2024){
    weatherlist[[counter]] <- importNOAA(code = vstations[X], year = Z) %>% 
      mutate(city = vcities[X])
    counter <- counter + 1
  }
}

rm(X, Z, counter, vcities, vstations)

