```{r, include = FALSE}

vfiles <- list.files("../Data/raw/San_Francisco/OneDrive_1_8-2-2026", pattern = "\\.csv\\.gz$", full.names = TRUE)
dfcalls_list <- vector("list", length(vfiles))


columns_selected <- c(
  "pd_incident_report" ,
  "received_datetime" ,
  "onscene_datetime",
  "close_datetime",
  "call_type_original",
  "call_type_original_desc" ,
  "priority_original",
  "disposition",
  "onview_flag"
)

for (X in seq_along(vfiles)) {
  dftemp <- fread(vfiles[X], select = columns_selected, check.names = TRUE) %>% 
    rename_all(tolower) %>% 
    mutate_all(as.character) %>% 
    select(-starts_with("v"))
  
  if (grepl("Weekly", vfiles[X])) {
    dftemp <- dftemp %>% rename(dateend = date)
  }
  
  dfcalls_list[[X]] <- dftemp
}

calls <- bind_rows(dfcalls_list)
rm(dftemp, X, vfiles, dfcalls_list, columns_selected); gc()

```



