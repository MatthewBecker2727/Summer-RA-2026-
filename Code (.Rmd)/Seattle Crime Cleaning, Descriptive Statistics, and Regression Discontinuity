```{r, include = FALSE}
#load cad.event.number to prevent double counting crimes, keep unique cad numbers

vfiles <- list.files("Data/raw/Seattle", pattern = "\\.csv$", full.names = TRUE)
dfcalls_list <- vector("list", length(vfiles))


columns_selected <- c(
  "CAD Event Number",
  "CAD Event Clearance Description",
  "Call Type",
  "Priority",
  "Initial Call Type",
  "Final Call Type",
  "CAD Event Original Time Queued",
  "CAD Event Arrived Time",
  "CAD Event Response Category",
  "Call Sign Dispatch Time"
)

for (X in seq_along(vfiles)) {
  # fread now selects ONLY these exact raw columns directly from disk
  dftemp <- fread(vfiles[X], select = columns_selected, check.names = TRUE) %>% 
    rename_all(tolower) %>% 
    mutate_all(as.character) %>% 
    select(-starts_with("v"))
  
  if (grepl("Weekly", vfiles[X])) {
    dftemp <- dftemp %>% rename(dateend = date)
  }
  
  dfcalls_list[[X]] <- dftemp
}

calls <- bind_rows(dfcalls_list)
rm(dftemp, X, vfiles, dfcalls_list); gc()

